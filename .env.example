# Application
APP_NAME=Browser Automation Agent API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB (local or Atlas)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=browser_automation

# JWT (generate a long random string for production)
JWT_SECRET=change-me-to-a-secure-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI (default: Ollama — free, local, no API key)
# Install: https://ollama.com then run: ollama pull llama3.2
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Optional free cloud keys (pick one provider and set AI_PROVIDER)
# Groq (free): https://console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier): https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI (paid)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# No AI — rule-based plan only
# AI_PROVIDER=none

# Browser automation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
AUTOMATION_MAX_STEPS=15

# CORS (Angular dev server default)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
